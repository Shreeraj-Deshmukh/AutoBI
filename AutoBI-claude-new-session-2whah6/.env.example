# Azure AI Foundry — copy to .env.local and fill in. Read only by the Celestra server
# (vite dev / vite preview); the key is never sent to the browser.
#
# Foundry Models endpoint:  https://<resource>.services.ai.azure.com/models
# Azure OpenAI endpoint:    https://<resource>.openai.azure.com
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Model / deployment name, e.g. gpt-4o, gpt-4.1-mini, Phi-4, DeepSeek-V3
AZURE_AI_MODEL=
# Optional
AZURE_AI_API_VERSION=

# Databricks (SQL Statement Execution API) — optional; can also be entered in the app
DATABRICKS_HOST=          # e.g. adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN=         # personal access token
DATABRICKS_WAREHOUSE_ID=  # SQL warehouse ID
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Snowflake (SQL API v2) — optional; can also be entered in the app
SNOWFLAKE_ACCOUNT=        # e.g. myorg-myaccount
SNOWFLAKE_TOKEN=          # programmatic access token (or OAuth token)
SNOWFLAKE_TOKEN_TYPE=     # PROGRAMMATIC_ACCESS_TOKEN (default) | OAUTH | KEYPAIR_JWT
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
